{
  "name": "agent-foundry-local",
  "version": "0.2.8",
  "private": true,
  "description": "Local durable agent orchestrator with a Windows desktop shell",
  "author": "Agent Foundry Local",
  "main": "dist-desktop/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "concurrently -k -n api,web -c cyan,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "cross-env NODE_ENV=production tsx server/index.ts",
    "start:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:build-main": "node desktop/build-main.mjs",
    "desktop:dev": "npm run build && npm run desktop:build-main && electron .",
    "desktop:smoke": "npm run build && npm run desktop:build-main && electron . --smoke-test",
    "appserver:smoke": "node tests/appserver-smoke.mjs",
    "runtime:smoke": "tsx tests/real-runtime-smoke.ts",
    "release:verify": "npm test && npm run runtime:smoke && npm run desktop:dist && node tests/verify-portable.mjs",
    "verifier:smoke": "tsx tests/verifier-workspace-smoke.ts",
    "sandbox:smoke": "tsx tests/docker-sandbox-smoke.ts",
    "desktop:pack": "npm run build && npm run desktop:build-main && electron-builder --win dir",
    "desktop:dist": "npm run build && npm run desktop:build-main && electron-builder --win portable",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test server/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .agent-data"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@openai/codex-sdk": "^0.146.1",
    "fastify": "^5.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  },
  "type": "module",
  "build": {
    "appId": "com.agentfoundry.local",
    "productName": "Agent Foundry",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Agent-Foundry-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/agent.env.example",
        "to": "agent.env.example"
      }
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "unpackDirName": false
    }
  }
}
