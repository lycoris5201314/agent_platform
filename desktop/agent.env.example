# 首次运行会在 EXE 旁生成 agent.env。保存后应用会自动重新加载 Provider 与模型配置。

# 无 Key 时自动使用 mock；填写任一兼容 Key 后自动使用 codex。
# 如需强制指定，可取消下一行注释并填写 mock 或 codex。
# AGENT_RUNTIME=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-codex
OPENAI_BASE_URL=

# DeepSeek Responses API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 其他兼容 OpenAI Responses API 的服务
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_WIRE_API=

# Windows 原生与 Codex 执行策略（默认无需 WSL2）
AGENT_WORKSPACE_MODE=native
AGENT_SANDBOX=native
# 仅在主动选择 WSL2 后使用：
WSL_DISTRO=Ubuntu-24.04
CODEX_PATH=
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=on-request

# Docker 沙箱（可选）：需要时把上面的 AGENT_SANDBOX 改为 docker。
# 模型通信需要 bridge；Codex 工具网络仍默认关闭。
AGENT_DOCKER_IMAGE=agent-foundry-sandbox:local
AGENT_DOCKER_CPUS=2
AGENT_DOCKER_MEMORY_MB=2048
AGENT_DOCKER_NETWORK=bridge
AGENT_DOCKER_IDLE_TTL_MINUTES=30

# 未来多用户部署可改为 token，并使用反向代理传 tenant/user/role 头。
AGENT_AUTH_MODE=local
AGENT_AUTH_TOKEN=

# 可选：有审批时向你的 HTTPS 服务发送一次幂等通知。
AGENT_APPROVAL_WEBHOOK_URL=
