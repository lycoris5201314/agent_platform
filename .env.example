# Web/API
AGENT_API_PORT=8788
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8788
AGENT_DATA_DIR=.agent-data

# Runtime: mock works without any key; codex uses the local Codex SDK/CLI.
AGENT_RUNTIME=mock
CODEX_PATH=
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=on-request

# Workspace: Windows native is the default and does not require WSL2.
AGENT_WORKSPACE_MODE=native
AGENT_SANDBOX=native
# Optional WSL2 backend: set both values above to wsl2.
WSL_DISTRO=Ubuntu-24.04

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-codex

# DeepSeek Responses API (currently Codex-compatible with deepseek-v4-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Any OpenAI-compatible provider
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# Set this only when the custom endpoint implements OpenAI Responses API.
MODEL_WIRE_API=
